# ─────────────────────────────────────────────────────────────────────────────
#  LilyCare – variabili d'ambiente
#
#  • In locale: copia questo file in `.env` e compila i valori.
#  • Su Namecheap: inseriscile in cPanel → Setup Node.js App → la tua app →
#    "Environment variables" (non serve caricare file .env sul server).
# ─────────────────────────────────────────────────────────────────────────────

# URL pubblico del sito (senza slash finale). Va impostato anche su GitHub
# (Settings → Secrets and variables → Actions → Variables) perché è usato durante la build.
NEXT_PUBLIC_SERVER_URL=https://lilycare.ch

# (Facoltativo) Indirizzo del sito letto all'avvio: ha la precedenza su NEXT_PUBLIC_SERVER_URL,
# così lo stesso pacchetto funziona anche su un altro indirizzo (es. la demo) senza ricompilare.
#   SERVER_URL=https://demo.lilycare.ch

# (Facoltativo) "true" per una demo/anteprima: il sito NON viene indicizzato da Google.
# Da togliere (o lasciare vuota) sul sito definitivo.
#   NOINDEX=true

# Chiave segreta del pannello admin: lunga e casuale (es. `openssl rand -hex 32`).
# Non cambiarla dopo la messa online, altrimenti tutti gli utenti dovranno riaccedere.
PAYLOAD_SECRET=

# Database SQLite (un solo file). Su Namecheap usa un percorso FUORI dalla cartella dell'app,
# così gli aggiornamenti del sito non lo toccano mai. Esempio:
#   DATABASE_URL=file:/home/UTENTE_CPANEL/lilycare-data/lilycare.db
DATABASE_URL=file:./data/lilycare.db

# Cartella delle immagini caricate dal pannello (anche questa fuori dall'app). Esempio:
#   MEDIA_DIR=/home/UTENTE_CPANEL/lilycare-data/media
MEDIA_DIR=media

# Email in uscita (richieste di appuntamento, bozze AI) – Namecheap Private Email
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=info@lilycare.ch
SMTP_PASS=
SMTP_FROM_ADDRESS=info@lilycare.ch
SMTP_FROM_NAME=LilyCare

# Assistente AI per le bozze degli articoli (Claude, Anthropic).
# Crea la chiave su https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# ─── Immagini di copertina degli articoli (facoltativo) ───
# L'assistente descrive l'illustrazione mentre scrive l'articolo e questo servizio la disegna.
# Senza la chiave gli articoli usano la copertina grafica predefinita del sito.
# Costo indicativo: 3-8 centesimi per immagine.
OPENAI_API_KEY=
# Modello da usare. Predefinito: gpt-image-2. Altri nomi validi (SDK OpenAI 7.47.0):
# gpt-image-2.5-flare, gpt-image-2.5-sunburst, gpt-image-1.5. Da evitare: gpt-image-1 (superato)
# e dall-e-2 / dall-e-3 (dismessi il 12 maggio 2026). Se la generazione fallisce con
# "model does not exist", qui si mette il nome nuovo senza ricompilare il sito.
#   OPENAI_IMAGE_MODEL=gpt-image-2
#   OPENAI_IMAGE_SIZE=1536x1024    (anche 1024x1024, 1024x1536, auto)
#   OPENAI_IMAGE_QUALITY=medium    (anche low, high, xhigh, max, auto)
# Per usare un altro fornitore compatibile con l'API di OpenAI:
#   OPENAI_BASE_URL=https://.../v1

# Chiave per il cron giornaliero di cPanel che chiede all'assistente la bozza del giorno
# (lunga e casuale, es. `openssl rand -hex 24`).
CRON_SECRET=

# (Facoltativo) "false" per NON caricare i contenuti iniziali al primo avvio con database vuoto.
# AUTO_SEED=true
