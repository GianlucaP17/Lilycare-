# ─────────────────────────────────────────────────────────────
#  LilyCare – variabili d'ambiente
#  Copia questo file in `.env` e compila i valori.
# ─────────────────────────────────────────────────────────────

# URL pubblico del sito (senza slash finale). Usato per SEO, sitemap, email.
NEXT_PUBLIC_SERVER_URL=https://lilycare.ch

# Chiave segreta per il pannello admin: una stringa lunga e casuale.
# Generala ad es. con:  openssl rand -hex 32
PAYLOAD_SECRET=

# Database
#  - In locale / server proprio: file SQLite
DATABASE_URL=file:./data/lilycare.db
#  - In cloud (es. Turso): libsql://nome-db.turso.io  + token
# DATABASE_AUTH_TOKEN=

# Email (SMTP) – le richieste di appuntamento vengono inviate via email.
# Se SMTP_HOST è vuoto, le email vengono solo stampate nel log (utile in sviluppo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=info@lilycare.ch
SMTP_FROM_NAME=LilyCare

# (Opzionale) Archiviazione immagini su Vercel Blob – solo se il sito è ospitato su Vercel.
# BLOB_READ_WRITE_TOKEN=
